{
  "name": "peer-map-symmetric-one-way",
  "policy": {
    "tagOwners": {
      "tag:server": ["alice@"]
    },
    "acls": [
      {
        "action": "accept",
        "src": ["alice@"],
        "dst": ["tag:server:*"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" },
    { "id": 2, "name": "server-owner" },
    { "id": 3, "name": "bob" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-laptop",
      "ipv4": "100.64.0.1"
    },
    {
      "id": 2,
      "user_id": 2,
      "hostname": "server",
      "ipv4": "100.64.0.2",
      "tags": ["tag:server"]
    },
    {
      "id": 3,
      "user_id": 3,
      "hostname": "bob-laptop",
      "ipv4": "100.64.0.3"
    }
  ],
  "peer_map_checks": [
    { "name": "alice-peers", "node_id": 1 },
    { "name": "server-peers", "node_id": 2 },
    { "name": "bob-peers", "node_id": 3 }
  ]
}
