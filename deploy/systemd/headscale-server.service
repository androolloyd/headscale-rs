[Unit]
Description=Headscale-rs Control Plane Server
Documentation=https://github.com/last-net/headscale-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=headscale
Group=headscale

# Binary location
ExecStart=/usr/local/bin/headscale server \
    --config /etc/headscale/config.toml

# Restart on failure
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitInterval=60

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Allow write to state directory
ReadWritePaths=/var/lib/headscale

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Environment
Environment=RUST_LOG=info
Environment=HEADSCALE_LOG=info

[Install]
WantedBy=multi-user.target
