{
  "name": "ssh-accept-env",
  "policy": {
    "tagOwners": {
      "tag:server": ["alice@"]
    },
    "ssh": [
      {
        "action": "accept",
        "acceptEnv": ["LANG", "LC_*"],
        "src": ["alice@"],
        "dst": ["tag:server"],
        "users": ["root"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-laptop",
      "ipv4": "100.64.0.1"
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "server",
      "ipv4": "100.64.0.2",
      "tags": ["tag:server"]
    }
  ],
  "ssh_checks": [
    { "name": "server", "node_id": 2 }
  ]
}
