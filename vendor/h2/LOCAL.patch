+        if self.0.live.swap(false, std::sync::atomic::Ordering::AcqRel) {
+            if let Some(idle) = inner.counts.go_client_idle.as_mut() {
+                debug_assert!(idle.reserved > 0);
+                idle.reserved -= 1;
+            }
+        }
+    }
