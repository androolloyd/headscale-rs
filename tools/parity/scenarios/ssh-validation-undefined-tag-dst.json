{
  "name": "ssh-validation-undefined-tag-dst",
  "expect_policy_error": "tag:notdefined",
  "policy": {
    "groups": {
      "group:defined": ["user@"]
    },
    "ssh": [
      {
        "action": "accept",
        "src": ["group:defined"],
        "dst": ["tag:notdefined"],
        "users": ["root"]
      }
    ]
  }
}
