{
  "name": "ssh-check-hold-delegate",
  "policy": {
    "tagOwners": {
      "tag:db": ["alice@"]
    },
    "ssh": [
      {
        "action": "check",
        "checkPeriod": "24h",
        "src": ["alice@"],
        "dst": ["tag:db"],
        "users": ["admin"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-laptop",
      "ipv4": "100.64.0.1"
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "db",
      "ipv4": "100.64.0.2",
      "tags": ["tag:db"]
    }
  ],
  "ssh_checks": [
    { "name": "db", "node_id": 2 }
  ]
}
