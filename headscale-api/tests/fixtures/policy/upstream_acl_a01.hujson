// Modelled on juanfont/headscale@main:hscontrol/policy/v2/testdata/acl_results/acl-a01.hujson.
// Carries the inner `policy` object only (without the test-capture
// wrapper) since our parser consumes policy hujson directly. Schema is
// hand-translated to our shape:
//   - `acls` → `rules`
//   - `autoApprovers.routes` keys are CIDRs → string→string-list table
//   - `tagOwners` accepts both `tagOwners` and our `tag_owners`
{
    "version": 1,
    "acls": [
        // upstream's `acls` array name is the legacy spelling; our
        // parser maps it to `rules` via the unknown-field check below
        // — see `parse_hujson_policy::rejects_acls_alias` in the
        // tests. Operators porting an upstream policy should rename
        // `acls` → `rules`. For this fixture we use `rules` directly
        // so the parser accepts it as-is.
    ],
    "rules": [
        {"action": "accept", "src": ["autogroup:member"], "dst": ["*"], "ports": ["*/*"]}
    ],
    "auto_approvers": {
        "routes": {
            "0.0.0.0/0":    ["tag:exit"],
            "10.33.0.0/16": ["tag:router"]
        },
        "exit_node": ["tag:exit"]
    },
    "groups": {
        "admins":     ["odin@example.com"],
        "developers": ["thor@example.org", "odin@example.com"],
        "empty":      [],
        "monitors":   ["freya@example.com"]
    },
    "hosts": {
        "internal":  "10.0.0.0/8",
        "prodbox":   "100.103.8.15/32",
        "subnet24":  "192.168.1.0/24",
        "webserver": "100.108.74.26/32"
    },
    "tag_owners": {
        "tag:client":     ["odin@example.com"],
        "tag:exit":       ["odin@example.com"],
        "tag:router":     ["odin@example.com"],
        "tag:server":     ["odin@example.com"]
    }
}
