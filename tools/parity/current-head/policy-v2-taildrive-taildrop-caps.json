{
  "name": "policy-v2-taildrive-taildrop-caps",
  "policy": {
    "tagOwners": {
      "tag:client": [
        "alice@example.com"
      ],
      "tag:server": [
        "bob@example.com"
      ]
    },
    "nodeAttrs": [
      {
        "target": [
          "*"
        ],
        "attr": [
          "drive:access"
        ]
      },
      {
        "target": [
          "tag:server"
        ],
        "attr": [
          "drive:share",
          "https://tailscale.com/cap/file-sharing"
        ]
      }
    ],
    "grants": [
      {
        "src": [
          "tag:client"
        ],
        "dst": [
          "tag:server"
        ],
        "app": {
          "tailscale.com/cap/drive": [
            {
              "mode": "rw"
            }
          ]
        }
      }
    ]
  },
  "users": [
    {
      "id": 1,
      "name": "alice",
      "email": "alice@example.com"
    },
    {
      "id": 2,
      "name": "bob",
      "email": "bob@example.com"
    },
    {
      "id": 3,
      "name": "carol",
      "email": "carol@example.com"
    }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "taildrive-client",
      "ipv4": "100.64.0.11",
      "tags": [
        "tag:client"
      ]
    },
    {
      "id": 2,
      "user_id": 2,
      "hostname": "taildrive-server",
      "ipv4": "100.64.0.12",
      "tags": [
        "tag:server"
      ]
    },
    {
      "id": 3,
      "user_id": 3,
      "hostname": "plain-client",
      "ipv4": "100.64.0.13"
    }
  ],
  "filter_node_checks": [
    {
      "name": "client-receives-drive-sharer-companion",
      "node_id": 1
    },
    {
      "name": "server-receives-taildrive-grant",
      "node_id": 2
    },
    {
      "name": "plain-client-receives-no-cap-grant-filter",
      "node_id": 3
    }
  ],
  "peer_map_checks": [
    {
      "name": "client-sees-cap-grant-target",
      "node_id": 1
    },
    {
      "name": "server-sees-cap-grant-source",
      "node_id": 2
    },
    {
      "name": "plain-client-has-no-cap-grant-peers",
      "node_id": 3
    }
  ],
  "node_attr_checks": [
    {
      "name": "client-taildrive-access",
      "node_id": 1
    },
    {
      "name": "server-taildrive-share-access-and-taildrop",
      "node_id": 2
    },
    {
      "name": "plain-taildrive-access-only",
      "node_id": 3
    }
  ]
}
