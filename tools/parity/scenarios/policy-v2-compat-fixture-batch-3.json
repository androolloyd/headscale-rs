      "ipv6": "fd7a:115c:a1e0::13"
    },
    {
      "id": 4,
      "user_id": 1,
      "hostname": "server",
      "ipv4": "100.64.0.16",
      "ipv6": "fd7a:115c:a1e0::10",
      "tags": [
        "tag:server"
      ]
    },
    {
      "id": 5,
      "user_id": 1,
      "hostname": "client",
      "ipv4": "100.64.0.17",
      "ipv6": "fd7a:115c:a1e0::17",
      "tags": [
        "tag:client"
      ]
    },
    {
      "id": 6,
      "user_id": 1,
      "hostname": "prod",
      "ipv4": "100.64.0.18",
      "ipv6": "fd7a:115c:a1e0::18",
      "tags": [
        "tag:prod"
      ]
    },
    {
      "id": 7,
      "user_id": 1,
      "hostname": "exit",
      "ipv4": "100.64.0.19",
      "ipv6": "fd7a:115c:a1e0::19",
      "tags": [
        "tag:exit"
