{
  "name": "route-via-steering",
  "policy": {
    "tagOwners": {
      "tag:router-a": ["router@"],
      "tag:router-b": ["router@"],
      "tag:group-a": ["client@"],
      "tag:group-b": ["client@"]
    },
    "grants": [
      {
        "src": ["tag:router-a", "tag:router-b", "tag:group-a", "tag:group-b"],
        "dst": ["tag:router-a", "tag:router-b", "tag:group-a", "tag:group-b"],
        "ip": ["*"]
      },
      {
        "src": ["tag:group-a"],
        "dst": ["10.0.0.0/24"],
        "ip": ["*"],
        "via": ["tag:router-a"]
      },
      {
        "src": ["tag:group-b"],
        "dst": ["10.0.0.0/24"],
        "ip": ["*"],
        "via": ["tag:router-b"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "router" },
    { "id": 2, "name": "client" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "router-a",
      "ipv4": "100.64.0.1",
      "tags": ["tag:router-a"],
      "routes": ["10.0.0.0/24"],
      "approved_routes": ["10.0.0.0/24"]
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "router-b",
      "ipv4": "100.64.0.2",
      "tags": ["tag:router-b"],
      "routes": ["10.0.0.0/24"],
      "approved_routes": ["10.0.0.0/24"]
    },
    {
      "id": 3,
      "user_id": 2,
      "hostname": "client-a",
      "ipv4": "100.64.0.3",
      "tags": ["tag:group-a"]
    },
    {
      "id": 4,
      "user_id": 2,
      "hostname": "client-b",
      "ipv4": "100.64.0.4",
      "tags": ["tag:group-b"]
    }
  ],
  "peer_map_checks": [
    { "name": "client-a-via-router-a", "node_id": 3 },
    { "name": "client-b-via-router-b", "node_id": 4 }
  ]
