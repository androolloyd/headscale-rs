{
  "groups": {
    "group:checkers": ["user1@"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"]
    }
  ],
  "ssh": [
    {
      "action": "check",
      "checkPeriod": "1h",
      "src": ["group:checkers"],
      "dst": ["autogroup:self"],
      "users": ["root"]
    },
    {
      "action": "check",
      "checkPeriod": "0",
      "src": ["group:checkers"],
      "dst": ["autogroup:self"],
      "users": ["deploy"]
    }
  ]
}
