{
  "name": "policy-v2-tailscale-compat-fixtures",
  "policy": {
    "groups": {
      "group:admins": [
        "odin@example.com"
      ],
      "group:developers": [
        "thor@example.org",
        "odin@example.com"
      ],
      "group:empty": [],
      "group:monitors": [
        "freya@example.com"
      ]
    },
    "hosts": {
      "internal": "10.0.0.0/8",
      "subnet_a": "192.168.1.0/24",
      "subnet_b": "172.16.0.0/24",
      "webserver": "100.108.74.26"
    },
    "tagOwners": {
      "tag:client": [
        "odin@example.com"
      ],
      "tag:exit": [
        "odin@example.com"
      ],
      "tag:ha": [
        "odin@example.com"
      ],
      "tag:router": [
        "odin@example.com"
      ],
      "tag:server": [
        "odin@example.com"
      ]
    },
    "autoApprovers": {
      "routes": {
        "0.0.0.0/0": [
          "tag:exit"
        ],
        "10.0.0.0/8": [
          "tag:router"
        ],
        "172.16.0.0/12": [
          "tag:router"
        ],
        "192.168.0.0/16": [
          "tag:ha"
        ],
        "::/0": [
          "tag:exit"
        ]
      }
    },
    "acls": [
      {
        "action": "accept",
        "src": [
          "autogroup:member"
        ],
        "dst": [
          "*:*"
        ]
      },
      {
        "action": "accept",
        "src": [
          "subnet_a"
        ],
        "dst": [
          "subnet_b:*"
        ]
      }
    ],
    "grants": [
      {
        "src": [
          "*"
        ],
        "dst": [
          "*"
        ],
        "app": {
          "example.com/cap/basic": [
            {}
          ]
        }
      },
      {
        "src": [
          "group:developers"
        ],
        "dst": [
          "tag:server"
        ],
        "ip": [
          "tcp:22",
          "udp:53"
        ]
      },
      {
        "src": [
          "odin@example.com"
        ],
        "dst": [
          "subnet_b"
        ],
        "ip": [
          "*"
        ],
        "via": [
          "tag:router"
        ]
      }
    ],
    "ssh": [
      {
        "action": "accept",
        "src": [
          "autogroup:member"
        ],
        "dst": [
          "autogroup:self"
        ],
        "users": [
          "root"
        ]
      },
      {
        "action": "accept",
        "acceptEnv": [
          "GIT_EDITOR",
          "TERM"
        ],
        "src": [
          "autogroup:member"
        ],
        "dst": [
          "tag:server"
        ],
        "users": [
          "root"
        ]
      },
      {
        "action": "check",
        "checkPeriod": "24h",
        "src": [
          "group:developers"
        ],
        "dst": [
          "tag:server"
        ],
        "users": [
          "localpart:*@example.com",
          "root"
        ]
      }
    ]
  },
  "users": [
    {
      "id": 1,
      "name": "odin",
      "email": "odin@example.com"
    },
    {
      "id": 2,
      "name": "thor",
      "email": "thor@example.org"
    },
    {
      "id": 3,
