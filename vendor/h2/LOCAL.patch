+    #[cfg(feature = "go-client-idle")]
+    pub(crate) fn go_poll_read(
+        &mut self,
+        cx: &Context<'_>,
+        stream: &mut Stream,
+        max: usize,
+        counts: &mut Counts,
+        task: &mut Option<Waker>,
+    ) -> Poll<GoReadOutcome> {
+        use super::stream::ContentLength;
+        let mut state = self
+            .go_body_reads
+            .as_mut()
+            .expect("native body read enabled")
+            .remove(&stream.id)
+            .unwrap_or_else(|| GoBodyReadState {
+                remaining: match &stream.content_length {
+                    ContentLength::Remaining(remaining) => Some(*remaining),
+                    ContentLength::Head => Some(0),
+                    ContentLength::Omitted => None,
+                },
+                error: None,
+                closed: false,
+                kind: GoBodyKind::Transport,
+            });
+        let mut result = GoReadOutcome {
+            data: Bytes::new(),
+            error: state.error.clone(),
+            eof: false,
+            gate: None,
+            abort: false,
+        };
+        if state.kind == GoBodyKind::NoBody {
+            result.eof = true;
+        } else if state.kind == GoBodyKind::MissingBody {
+            result.error =
+                Some(io::Error::new(io::ErrorKind::UnexpectedEof, "unexpected EOF").into());
+        } else if result.error.is_none() {
+            let mut data = bytes::BytesMut::new();
+            loop {
+                match stream.pending_recv.pop_front(&mut self.buffer) {
+                    Some(Event::Data(mut event)) => {
+                        if event.payload.is_empty() {
+                            if event.is_budgeted {
+                                counts.release_data_frame(event.budget_len());
+                            }
+                            continue;
+                        }
+                        let len = (max - data.len()).min(event.payload.len());
+                        let original_len = event.budget_len();
+                        data.extend_from_slice(&event.payload.split_to(len));
+                        if !event.payload.is_empty() {
+                            event.go_original_len = Some(original_len);
+                            stream
+                                .pending_recv
+                                .push_front(&mut self.buffer, Event::Data(event));
+                        } else if event.is_budgeted {
+                            counts.release_data_frame(original_len);
+                        }
+                        if data.len() == max {
+                            break;
+                        }
+                    }
+                    Some(event) => {
+                        stream.pending_recv.push_front(&mut self.buffer, event);
+                        if data.is_empty() {
+                            result.eof = true;
+                        }
+                        break;
+                    }
+                    None if !data.is_empty() => break,
+                    None => match self.schedule_recv::<DataEvent>(cx, stream) {
+                        Poll::Pending => {
+                            self.go_body_reads
+                                .as_mut()
+                                .unwrap()
+                                .insert(stream.id, state);
+                            return Poll::Pending;
+                        }
+                        Poll::Ready(Some(Err(error))) => {
+                            result.error = Some(error);
+                            break;
+                        }
+                        Poll::Ready(None) => {
+                            result.eof = true;
+                            break;
+                        }
+                        Poll::Ready(Some(Ok(_))) => unreachable!(),
+                    },
+                }
+            }
+            let consumed = data.len();
+            result.data = data.freeze();
+            let mut early_error = false;
+            if let Some(remaining) = state.remaining.as_mut() {
+                if consumed as u64 > *remaining {
+                    result.data.truncate(*remaining as usize);
+                    let error: proto::Error = io::Error::other(
+                        "net/http: server replied with more than declared Content-Length; truncated",
+                    )
+                    .into();
+                    state.error = Some(error.clone());
+                    result.error = Some(error);
+                    result.abort = true;
+                    early_error = true;
+                } else {
