{
  "name": "ssh-action-whitespace",
  "policy": {
    "tagOwners": {
      "tag:server": ["alice@"]
    },
    "ssh": [
      {
        "action": " accept ",
        "src": ["alice@"],
        "dst": ["tag:server"],
        "users": ["root"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" },
    { "id": 2, "name": "bob" }
  ],
  "nodes": [
    { "id": 1, "user_id": 1, "hostname": "alice-laptop", "ipv4": "100.64.0.1" },
    { "id": 2, "user_id": 2, "hostname": "server", "ipv4": "100.64.0.2", "tags": ["tag:server"] }
  ],
  "ssh_checks": [
    { "name": "server-ssh", "node_id": 2 }
  ]
}
