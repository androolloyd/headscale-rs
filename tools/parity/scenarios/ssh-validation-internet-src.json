{
  "name": "ssh-validation-internet-src",
  "expect_policy_error": "\"autogroup:internet\" used in SSH source",
  "policy": {
    "tagOwners": {
      "tag:server": ["alice@"]
    },
    "ssh": [
      {
        "action": "accept",
        "src": ["autogroup:internet"],
        "dst": ["tag:server"],
        "users": ["root"]
      }
    ]
  }
}
