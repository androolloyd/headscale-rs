{
  "name": "ssh-policy-matrix",
  "policy": {
    "groups": {
      "group:admins": ["bob@"]
    },
    "hosts": {
      "serverHost": "100.64.0.4/32"
    },
    "tagOwners": {
      "tag:server": ["alice@"],
      "tag:db": ["alice@"]
    },
    "acls": [],
    "ssh": [
      {
        "action": "accept",
        "src": ["group:admins"],
        "dst": ["tag:server"],
        "users": ["ssh-it-user"]
      },
      {
        "action": "accept",
        "src": ["bob@"],
        "dst": ["serverHost"],
        "users": ["autogroup:nonroot", "root", "deploy"]
      },
      {
        "action": "check",
        "checkPeriod": "24h",
        "src": ["group:admins"],
        "dst": ["tag:db"],
        "users": ["admin"]
      },
      {
        "action": "accept",
        "src": ["alice@"],
        "dst": ["autogroup:self"],
        "users": ["autogroup:nonroot"]
      },
      {
        "action": "accept",
        "src": ["tag:server"],
        "dst": ["autogroup:tagged"],
        "users": ["root"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" },
    { "id": 2, "name": "bob" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-laptop",
      "ipv4": "100.64.0.1",
      "ipv6": "fd7a:115c:a1e0::1"
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "alice-phone",
      "ipv4": "100.64.0.2",
      "ipv6": "fd7a:115c:a1e0::2"
    },
    {
      "id": 3,
      "user_id": 2,
      "hostname": "bob-laptop",
      "ipv4": "100.64.0.3",
      "ipv6": "fd7a:115c:a1e0::3"
    },
    {
      "id": 4,
      "user_id": 1,
      "hostname": "server",
      "ipv4": "100.64.0.4",
      "ipv6": "fd7a:115c:a1e0::4",
      "tags": ["tag:server"]
    },
    {
      "id": 5,
      "user_id": 1,
      "hostname": "db",
      "ipv4": "100.64.0.5",
      "ipv6": "fd7a:115c:a1e0::5",
      "tags": ["tag:db"]
    }
  ],
  "ssh_checks": [
    { "name": "alice-laptop", "node_id": 1 },
    { "name": "bob-laptop", "node_id": 3 },
    { "name": "server", "node_id": 4 },
    { "name": "db", "node_id": 5 }
  ]
}
