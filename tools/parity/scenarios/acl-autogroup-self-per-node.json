{
  "name": "acl-autogroup-self-per-node",
  "policy": {
    "groups": {
      "group:admins": ["alice@"]
    },
    "tagOwners": {
      "tag:router": ["alice@"]
    },
    "acls": [
      {
        "action": "accept",
        "src": ["autogroup:member"],
        "dst": ["autogroup:self:22"]
      },
      {
        "action": "accept",
        "src": ["tag:router"],
        "dst": ["alice@:80"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" },
    { "id": 2, "name": "bob" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-a",
      "ipv4": "100.64.0.10",
      "ipv6": "fd7a:115c:a1e0::10"
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "alice-b",
      "ipv4": "100.64.0.11",
      "ipv6": "fd7a:115c:a1e0::11"
    },
    {
      "id": 3,
      "user_id": 2,
      "hostname": "bob-a",
      "ipv4": "100.64.0.20",
      "ipv6": "fd7a:115c:a1e0::20"
    },
    {
      "id": 4,
      "user_id": 1,
      "hostname": "router",
      "ipv4": "100.64.0.30",
      "ipv6": "fd7a:115c:a1e0::30",
      "tags": ["tag:router"]
    }
  ],
  "filter_node_checks": [
    { "name": "alice-a-filter", "node_id": 1 },
    { "name": "bob-a-filter", "node_id": 3 },
    { "name": "tagged-router-filter", "node_id": 4 }
  ]
}
