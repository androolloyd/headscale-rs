{
  "name": "policy-v2-compat-fixture-batch-3",
  "policy": {
    "groups": {
      "group:admins": [
        "odin@example.com"
      ],
      "group:developers": [
        "thor@example.org",
        "odin@example.com"
      ],
      "group:monitors": [
        "freya@example.com"
      ]
    },
    "hosts": {
      "srv": "100.64.0.16",
      "webserver": "100.64.0.16"
    },
    "tagOwners": {
      "tag:client": [
        "odin@example.com"
      ],
      "tag:exit": [
        "odin@example.com"
      ],
      "tag:prod": [
        "odin@example.com"
      ],
      "tag:server": [
        "odin@example.com"
      ]
    },
    "autoApprovers": {
      "exitNode": [
        "tag:exit"
      ]
    },
    "nodeAttrs": [
      {
        "target": [
          "*"
        ],
        "attr": [
          "disable-relay-server"
        ]
      },
      {
        "target": [
          "tag:server"
        ],
        "attr": [
          "custom:headscale-test"
        ]
      },
      {
        "target": [
          "tag:exit"
        ],
        "attr": [
          "suggest-exit-node"
        ]
      },
      {
        "target": [
          "autogroup:member"
        ],
        "attr": [
          "randomize-client-port"
        ]
      }
    ],
    "acls": [
      {
        "action": "accept",
        "src": [
          "odin@example.com"
        ],
        "dst": [
          "tag:server:22"
        ]
      },
      {
        "action": "accept",
        "proto": "6",
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "webserver:443"
        ]
      },
      {
        "action": "accept",
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "webserver:80"
        ]
      },
      {
        "action": "accept",
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "tag:server:22"
        ]
      }
    ],
    "grants": [
      {
        "src": [
          "tag:client"
        ],
        "dst": [
          "webserver"
        ],
        "ip": [
          "tcp:80"
        ]
      },
      {
        "src": [
          "tag:client"
        ],
        "dst": [
          "fd7a:115c:a1e0::10"
        ],
        "ip": [
          "tcp:22"
        ]
      }
    ],
    "tests": [
      {
        "src": "odin@example.com",
        "accept": [
          "tag:server:22"
        ]
      },
      {
        "src": "tag:client",
        "accept": [
          "webserver:80"
        ]
      },
      {
        "src": "thor@example.org",
        "proto": "6",
        "accept": [
          "webserver:443"
        ]
      },
      {
        "src": "thor@example.org",
        "accept": [
          "webserver:80"
        ]
      },
      {
        "src": "thor@example.org",
        "accept": [
          "webserver:80"
        ]
      },
      {
        "src": "tag:client",
        "accept": [
          "[fd7a:115c:a1e0::10]:22"
        ]
      }
    ],
    "ssh": [
      {
        "action": "accept",
        "acceptEnv": [
          "GIT_EDITOR",
          "TERM"
        ],
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "tag:server"
        ],
        "users": [
          "root"
        ]
      },
      {
        "action": "check",
        "checkPeriod": "24h",
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "tag:server"
        ],
        "users": [
          "admin"
        ]
      },
      {
        "action": "accept",
        "src": [
          "odin@example.com"
        ],
        "dst": [
          "tag:server"
        ],
        "users": [
          "localpart:*@example.com"
        ]
      },
      {
        "action": "accept",
        "src": [
          "thor@example.org"
        ],
        "dst": [
          "tag:prod"
        ],
        "users": [
          "root"
        ]
      }
    ],
    "sshTests": [
      {
        "src": "thor@example.org",
        "dst": [
          "tag:server"
        ],
        "accept": [
          "root"
        ]
      },
      {
        "src": "thor@example.org",
        "dst": [
          "tag:server"
        ],
        "check": [
          "admin"
        ]
      },
      {
        "src": "odin@example.com",
        "dst": [
          "tag:server"
        ],
        "accept": [
          "odin"
        ]
      },
      {
        "src": "freya@example.com",
        "dst": [
          "tag:server"
        ],
        "deny": [
          "root"
        ]
      }
    ]
  },
  "users": [
    {
      "id": 1,
      "name": "odin",
      "email": "odin@example.com"
    },
    {
      "id": 2,
      "name": "thor",
      "email": "thor@example.org"
    },
    {
      "id": 3,
      "name": "freya",
      "email": "freya@example.com"
    }
