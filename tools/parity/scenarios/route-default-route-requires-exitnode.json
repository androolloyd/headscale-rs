{
  "name": "route-default-route-requires-exitnode",
  "policy": {
    "groups": {
      "group:admins": ["alice@"]
    },
    "acls": [
      { "action": "accept", "src": ["*"], "dst": ["*:*"] }
    ],
    "autoApprovers": {
      "routes": {
        "0.0.0.0/0": ["group:admins"],
        "::/0": ["group:admins"]
      }
    }
  },
  "users": [
    { "id": 1, "name": "alice" }
  ],
  "nodes": [
    { "id": 1, "user_id": 1, "hostname": "alice-laptop", "ipv4": "100.64.0.1" }
  ],
  "route_checks": [
    {
      "name": "route-autoapprovers-do-not-grant-v4-default",
      "node_id": 1,
      "announced_routes": ["0.0.0.0/0"]
    },
    {
      "name": "route-autoapprovers-do-not-grant-v6-default",
      "node_id": 1,
      "announced_routes": ["::/0"]
    }
  ]
}
