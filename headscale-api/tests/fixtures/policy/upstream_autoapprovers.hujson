// Exercises upstream v0.28 `autoApprovers` (routes + exitNode).
{
    "tagOwners": {
        "tag:router": ["alice@example.com"],
        "tag:exit":   ["alice@example.com"]
    },
    "acls": [
        {"action": "accept", "src": ["*"], "dst": ["*:*"]}
    ],
    "autoApprovers": {
        "routes": {
            "10.0.0.0/8":    ["tag:router"],
            "172.16.0.0/12": ["group:admins"],
            "0.0.0.0/0":     ["tag:exit"]
        },
        "exitNode": ["tag:exit"]
    },
    "groups": {
        "group:admins": ["alice@example.com", "bob@example.com"]
    }
}
