+#[cfg(feature = "go-native-client")]
+fn go_prepare_user_agent<B>(request: &mut Request<B>, http2: bool) {
+    use hyper::header::USER_AGENT;
+    if request.extensions().get::<GoAutoUserAgent>().is_none() {
+        return;
+    }
+    let original = match request.extensions().get::<GoOriginalUserAgent>() {
+        Some(original) => original.clone(),
+        None => {
+            let original = GoOriginalUserAgent(
+                request
+                    .headers()
+                    .get_all(USER_AGENT)
+                    .iter()
+                    .cloned()
+                    .collect(),
+            );
+            request.extensions_mut().insert(original.clone());
+            original
+        }
+    };
+    request.headers_mut().remove(USER_AGENT);
+    if original.0.is_empty() {
+        request.headers_mut().insert(
+            USER_AGENT,
+            HeaderValue::from_static(if http2 {
+                "Go-http-client/2.0"
+            } else {
+                "Go-http-client/1.1"
+            }),
+        );
+    } else {
+        // An explicitly empty first field suppresses Go's generated agent.
+        // Only the first User-Agent value is written by the Go transports.
+        if let Some(value) = original
+            .0
+            .into_iter()
+            .next()
+            .filter(|value| !value.is_empty())
+        {
+            if http2 {
+                request.headers_mut().insert(USER_AGENT, value);
+            } else {
+                let bytes = value.as_bytes();
+                if let Some(start) = bytes.iter().position(|byte| !matches!(byte, b' ' | b'\t')) {
+                    let end = bytes
+                        .iter()
+                        .rposition(|byte| !matches!(byte, b' ' | b'\t'))
+                        .unwrap()
+                        + 1;
+                    // Trimming ASCII whitespace preserves HeaderValue validity.
+                    if let Ok(value) = HeaderValue::from_bytes(&bytes[start..end]) {
+                        request.headers_mut().insert(USER_AGENT, value);
+                    }
+                } else {
+                    // Go tests nonempty before trimming, so a whitespace-only
+                    // original field is written with an empty value.
+                    request
+                        .headers_mut()
+                        .insert(USER_AGENT, HeaderValue::from_static(""));
+                }
+            }
+        }
+    }
+}
+
+#[cfg(feature = "go-native-client")]
+fn go_prepare_gzip<B>(request: &mut Request<B>, http2: bool) -> Option<bool> {
+    use hyper::header::{ACCEPT_ENCODING, RANGE};
+    request.extensions().get::<GoAutoGzip>()?;
+    go_prepare_user_agent(request, http2);
+    let original = match request.extensions().get::<GoOriginalAcceptEncoding>() {
+        Some(original) => original.clone(),
+        None => {
+            let original = GoOriginalAcceptEncoding(
+                request
+                    .headers()
+                    .get_all(ACCEPT_ENCODING)
+                    .iter()
+                    .cloned()
+                    .collect(),
+            );
+            request.extensions_mut().insert(original.clone());
+            original
+        }
+    };
+    // A canceled internal attempt can be retried on a different protocol.
+    // Restore caller fields before applying that connection's gzip rule.
+    request.headers_mut().remove(ACCEPT_ENCODING);
+    for value in original.0 {
+        request.headers_mut().append(ACCEPT_ENCODING, value);
+    }
+    let requested = request.method() != Method::HEAD
+        && if http2 {
+            // HeaderMap cannot represent a present key with a zero-length vector;
+            // a present empty HeaderValue corresponds to Go's []string{""}.
+            !request.headers().contains_key(ACCEPT_ENCODING)
+                && !request.headers().contains_key(RANGE)
+        } else {
+            request
+                .headers()
+                .get(ACCEPT_ENCODING)
+                .is_none_or(|value| value.as_bytes().is_empty())
+                && request
+                    .headers()
+                    .get(RANGE)
+                    .is_none_or(|value| value.as_bytes().is_empty())
+        };
+    if requested {
+        // Go HTTP/1 writes its extra gzip field after caller fields, including
+        // an explicitly empty Accept-Encoding; do not replace that field.
+        request
+            .headers_mut()
+            .append(ACCEPT_ENCODING, HeaderValue::from_static("gzip"));
+    }
+    Some(requested)
+}
 
