{
  "name": "multi-address-policy-ssh-route-matrix",
  "policy": {
    "tagOwners": {
      "tag:server": ["router@"],
      "tag:router": ["router@"]
    },
    "acls": [
      {
        "action": "accept",
        "src": ["alice@"],
        "dst": ["tag:server:443"]
      },
      {
        "action": "accept",
        "src": ["alice@"],
        "dst": ["fd7a:115c:a1e0:b10::/64:*"]
      }
    ],
    "ssh": [
      {
        "action": "accept",
        "src": ["alice@"],
        "dst": ["tag:server"],
        "users": ["root"]
      }
    ]
  },
  "users": [
    { "id": 1, "name": "alice" },
    { "id": 2, "name": "router" }
  ],
  "nodes": [
    {
      "id": 1,
      "user_id": 1,
      "hostname": "alice-dual",
      "ipv4": "100.64.0.10",
      "ipv6": "fd7a:115c:a1e0::10"
    },
    {
      "id": 2,
      "user_id": 1,
      "hostname": "alice-v6-only",
      "ipv4": "",
      "ipv6": "fd7a:115c:a1e0::20"
    },
    {
      "id": 3,
      "user_id": 2,
      "hostname": "server-dual",
      "ipv4": "100.64.0.30",
      "ipv6": "fd7a:115c:a1e0::30",
      "tags": ["tag:server"]
    },
    {
      "id": 4,
      "user_id": 2,
      "hostname": "router-v6-only",
      "ipv4": "",
      "ipv6": "fd7a:115c:a1e0::40",
      "tags": ["tag:router"],
      "routes": ["fd7a:115c:a1e0:b10::/64"],
      "approved_routes": ["fd7a:115c:a1e0:b10::/64"]
    }
  ],
  "filter_node_checks": [
    { "name": "server-dual-filter", "node_id": 3 },
    { "name": "router-v6-only-filter", "node_id": 4 }
  ],
  "peer_map_checks": [
    { "name": "alice-dual-peers", "node_id": 1 },
    { "name": "alice-v6-only-peers", "node_id": 2 },
    { "name": "server-dual-peers", "node_id": 3 },
    { "name": "router-v6-only-peers", "node_id": 4 }
  ],
  "ssh_checks": [
    { "name": "alice-dual", "node_id": 1 },
    { "name": "alice-v6-only", "node_id": 2 },
    { "name": "server-dual", "node_id": 3 }
  ]
}
