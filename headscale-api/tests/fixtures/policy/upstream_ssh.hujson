// Exercises `ssh` grant block round-trip — same shape upstream uses
// in `hscontrol/policy/v2/testdata/ssh_results/*`.
{
    "version": 1,
    "rules": [
        {"action": "accept", "src": ["*"], "dst": ["*"], "ports": ["*/*"]}
    ],
    "ssh": [
        {
            "action": "accept",
            "src":    ["group:admins"],
            "dst":    ["autogroup:tagged"],
            "users":  ["root"]
        },
        {
            "action": "check",
            "src":    ["group:developers"],
            "dst":    ["tag:dev"],
            "users":  ["alice", "bob"]
        }
    ],
    "groups": {
        "group:admins":     ["alice@example.com"],
        "group:developers": ["bob@example.com"]
    },
    "tagOwners": {
        "tag:dev": ["group:admins"]
    }
}
